{
  extends: [
    'config:recommended',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.github/workflows/build.yml$/',
      ],
      matchStrings: [
        ".*echo 'HUGO_VERSION=(?<currentValue>.*?)'.*\n",
      ],
      depNameTemplate: 'gohugoio/hugo',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'devDependencies',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'dependencies',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHubActions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      platformAutomerge: true,
      timezone: 'Asia/Tokyo',
      schedule: [
        'at 3pm on Friday',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'major',
      ],
      automerge: true,
      platformAutomerge: true,
    },
  ],
}
